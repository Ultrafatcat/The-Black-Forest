extends layout

block content
  .py-4
    h1.mb-1= heading
    p.text-muted.mb-4= intro

    if message
      .alert(class='alert-' + message.type)= message.text

    if entries.length === 0
      .card.bg-dark.border-secondary
        .card-body
          p.text-muted.fst-italic.mb-0= emptyMessage
    else
      .table-responsive
        table.table.table-striped.align-middle
          thead
            tr
              th #
              th Player
              th Character
              th.text-end Level
              th.text-end Defeated
              th.text-end Explored
              th.text-end Score
              if showFriendActions
                th
          tbody
            each entry in entries
              tr(class=entry.userId === currentUserId ? 'table-active' : '')
                td= entry.rank
                td
                  = entry.nickname
                  if entry.userId === currentUserId
                    span.badge.text-bg-success.ms-2 You
                td
                  = entry.characterName
                  span.text-muted.small= ' · ' + entry.race + ' ' + entry.characterClass
                td.text-end= entry.level
                td.text-end= entry.monstersDefeated
                td.text-end= entry.roomsExplored
                td.text-end
                  strong= entry.score
                if showFriendActions
                  td.text-end
                    if entry.userId === currentUserId
                      //- your own row has no friend action
                    else if friendStates[entry.userId] === 'friends'
                      span.badge.text-bg-secondary Friends
                    else if friendStates[entry.userId] === 'request_sent'
                      span.badge.text-bg-secondary Request sent
                    else if friendStates[entry.userId] === 'request_received'
                      a.btn.btn-sm.btn-outline-success(href="/friends") Answer request
                    else
                      form(method="post" action="/friends/request")
                        input(type="hidden" name="userId" value=entry.userId)
                        input(type="hidden" name="returnTo" value="leaderboard")
                        button.btn.btn-sm.btn-outline-success(type="submit") Add friend

    .mt-4
      a.btn.btn-outline-light(href=backHref)= backLabel
