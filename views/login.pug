extends layout

block content
  .text-center.py-5
    h1.mb-4 Login

    if error
      .alert.alert-danger.col-10.col-sm-6.col-md-4.mx-auto= error

    form.col-10.col-sm-6.col-md-4.mx-auto.text-start(method="post" action="/login")
      .mb-3
        label.form-label(for="login-username") Username
        input#login-username.form-control(type="text" name="username" value=username required autocomplete="username")
      .mb-3
        label.form-label(for="login-password") Password
        input#login-password.form-control(type="password" name="password" required autocomplete="current-password")

      .d-grid.gap-2.mt-4
        button.btn.btn-primary.btn-lg(type="submit") Login
        a.btn.btn-outline-light.btn-lg(href="/register") Sign Up
        a.btn.btn-outline-secondary(href="/") Return
