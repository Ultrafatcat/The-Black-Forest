nav.navbar.navbar-expand-md.navbar-dark.bg-dark
  .container
    a.navbar-brand(href="/") The Black Forest
    button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navLinks")
      span.navbar-toggler-icon
    #navLinks.collapse.navbar-collapse
      ul.navbar-nav.ms-auto
        li.nav-item
          span.nav-link.disabled Dictionary
        li.nav-item
          span.nav-link.disabled Leaderboard
        li.nav-item
          span.nav-link.disabled Settings
        if user
          li.nav-item
            span.nav-link #{user.nickname}
          li.nav-item
            form(method="post" action="/logout")
              button.btn.btn-link.nav-link(type="submit") Log out
        else
          li.nav-item
            a.nav-link(href="/login") Login