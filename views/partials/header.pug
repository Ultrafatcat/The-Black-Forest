nav.navbar.navbar-expand-md.navbar-dark.bg-dark
  .container
    a.navbar-brand(href="/")
      i.bi.bi-tree-fill.me-1
      | The Black Forest
    button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navLinks")
      span.navbar-toggler-icon
    #navLinks.collapse.navbar-collapse
      ul.navbar-nav.ms-auto
        //- Nav holds account identity only -- Dictionary, Leaderboard, Settings
        //- etc. are destinations and live as buttons on the menu page instead,
        //- so they're not duplicated in two places on screen.
        if user
          li.nav-item
            //- Stand-in for the account page (not built yet): the Login link
            //- "evolves" into the player's name once a session exists.
            span.nav-link #{user.nickname}
          li.nav-item
            form(method="post" action="/logout")
              button.btn.btn-link.nav-link(type="submit") Log out
        else
          li.nav-item
            a.nav-link(href="/login") Login