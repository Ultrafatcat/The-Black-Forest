extends layout

block content
  .py-4
    h1.mb-1 Dictionary
    p.text-muted.mb-4 Every command the Adventure page understands. This explains syntax, not when to use one.

    .card.bg-dark.border-secondary
      .list-group.list-group-flush
        each entry in entries
          .list-group-item.bg-dark
            .d-flex.justify-content-between.align-items-start.flex-wrap.gap-2
              code.text-success= entry.syntax
              if !entry.available
                span.badge.bg-secondary Coming in Checkpoint 4
            p.mb-0.mt-1.text-muted= entry.description

    .mt-4
      a.btn.btn-outline-light(href=returnTo)= returnTo === '/character/adventure' ? 'Return to Adventure' : 'Return to Menu'
